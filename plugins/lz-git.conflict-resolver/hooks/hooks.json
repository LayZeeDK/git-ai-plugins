{
  "description": "Proactive conflict detection after git merge, pull, and rebase operations",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-conflicts.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
